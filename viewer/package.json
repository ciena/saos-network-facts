{
  "name": "saos-network-facts-viewer",
  "version": "0.23.2",
  "private": true,
  "description": "3D view of a saos-network-facts facts file: physical, IS-IS, SR policy, BGP, pseudowire and CFM layers over one topology.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:render": "vite build -c vite.render.config.js",
    "preview": "vite preview",
    "test": "vitest run",
    "render": "node bin/saos-network-facts-render.mjs"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "three": "^0.169.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "bin": {
    "saos-network-facts-render": "bin/saos-network-facts-render.mjs"
  }
}
