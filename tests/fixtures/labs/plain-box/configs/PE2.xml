<!-- Synthetic SAOS 10 NETCONF configuration for tests. -->
<config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">
  <system xmlns="http://openconfig.net/yang/system">
    <config><hostname>PE2</hostname></config>
  </system>
  <fds xmlns="urn:ciena:params:xml:ns:yang:ciena-pn:ciena-mef-fd">
    <fd><name>FD-CORE-1</name><mode>vpls</mode></fd>
    <fd><name>FD-VPWS-100</name><mode>vpws</mode></fd>
  </fds>
  <classifiers xmlns="urn:ciena:params:xml:ns:yang:ciena-pn::ciena-mef-classifier">
    <classifier>
      <name>VLAN100</name>
      <filter-entry>
        <filter-parameter xmlns:classifier="urn:ciena:params:xml:ns:yang:ciena-pn::ciena-mef-classifier">classifier:vtag-stack</filter-parameter>
        <vtags><tag>1</tag><vlan-id>100</vlan-id></vtags>
      </filter-entry>
    </classifier>
  </classifiers>
  <interfaces xmlns="http://openconfig.net/yang/interfaces">
    <interface>
      <name>lb0</name>
      <config>
        <name>lb0</name>
        <type xmlns="http://ciena.com/ns/yang/ciena-openconfig-interfaces">loopback</type>
      </config>
      <ipv4 xmlns="http://ciena.com/ns/yang/ciena-openconfig-if-ip">
        <addresses><address><ip>192.0.2.2</ip><config><ip>192.0.2.2</ip><prefix-length>32</prefix-length></config></address></addresses>
      </ipv4>
    </interface>
    <interface>
      <name>PE2-PE1</name>
      <config>
        <name>PE2-PE1</name>
        <mtu>9000</mtu>
        <type xmlns="http://ciena.com/ns/yang/ciena-openconfig-interfaces">ip</type>
        <underlay-binding xmlns="http://ciena.com/ns/yang/ciena-underlay-binding"><config><fd>FD-CORE-1</fd></config></underlay-binding>
      </config>
      <ipv4 xmlns="http://ciena.com/ns/yang/ciena-openconfig-if-ip">
        <addresses><address><ip>198.51.100.1</ip><config><ip>198.51.100.1</ip><prefix-length>31</prefix-length></config></address></addresses>
      </ipv4>
    </interface>
  </interfaces>
  <fps xmlns="urn:ciena:params:xml:ns:yang:ciena-pn:ciena-mef-fp">
    <fp><name>FP-CORE-1</name><fd-name>FD-CORE-1</fd-name><logical-port>1</logical-port></fp>
    <fp><name>FP-AC-100</name><fd-name>FD-VPWS-100</fd-name><logical-port>3</logical-port><classifier-list>VLAN100</classifier-list></fp>
  </fps>
  <isis xmlns="http://ciena.com/ns/yang/ciena-isis">
    <instance>
      <tag>CORE</tag>
      <net>49.0001.1920.0000.2002.00</net>
      <level-type>level-2</level-type>
      <interfaces>
        <interface><name>lb0</name><interface-type>point-to-point</interface-type></interface>
        <interface><name>PE2-PE1</name><interface-type>point-to-point</interface-type><level-type>level-2</level-type><level-2><metric>30</metric><wide-metric>100</wide-metric></level-2></interface>
      </interfaces>
      <segment-routing>
        <enabled>true</enabled>
        <srgb><lower-bound>16000</lower-bound><upper-bound>23999</upper-bound></srgb>
      </segment-routing>
    </instance>
  </isis>
  <segment-routing xmlns="http://ciena.com/ns/yang/ciena-sr">
    <connected-prefix-sid-map>
      <prefix>192.0.2.2/32</prefix>
      <interface>lb0</interface>
      <value-type>index</value-type>
      <start-sid>2</start-sid>
    </connected-prefix-sid-map>
  </segment-routing>
  <bgp xmlns="http://ciena.com/ns/yang/ciena-bgp">
    <instance>
      <as>65000</as>
      <router-id>192.0.2.2</router-id>
      <peer>
        <address>192.0.2.1</address>
        <remote-as>65000</remote-as>
        <address-family><afi>l2vpn</afi><safi>evpn</safi><activate>true</activate></address-family>
      </peer>
    </instance>
  </bgp>
  <pseudowires xmlns="urn:ietf:params:xml:ns:yang:ietf-pseudowires">
    <pseudowire>
      <name>PW-100</name>
      <configured-pw><peer-ip>192.0.2.1</peer-ip><pw-id>100</pw-id></configured-pw>
      <mode xmlns="http://ciena.com/ns/yang/ciena-ietf-pseudowires">spoke</mode>
    </pseudowire>
  </pseudowires>
  <l2vpn-services xmlns="http://ciena.com/ns/yang/ciena-l2vpn">
    <l2vpn><name>VPWS-100</name><forwarding-domain>FD-VPWS-100</forwarding-domain><pseudowire>PW-100</pseudowire></l2vpn>
  </l2vpn-services>
  <maintenance-domain xmlns="http://metroethernetforum.org/ns/yang/mef-cfm">
    <id>MD5</id>
    <name-type>character-string</name-type>
    <name>MD5</name>
    <md-level>5</md-level>
    <maintenance-association>
      <id>MA-100</id>
      <name-type>character-string</name-type>
      <name>MA-100</name>
      <component-list>
        <component-id>1</component-id>
        <fd-name xmlns="urn:ciena:params:xml:ns:yang:ciena-pn:ciena-cfm">FD-VPWS-100</fd-name>
      </component-list>
      <ccm-interval>10ms</ccm-interval>
      <maintenance-association-end-point>
        <mep-identifier>12</mep-identifier>
        <interface>FP-AC-100</interface>
        <direction>up</direction>
      </maintenance-association-end-point>
    </maintenance-association>
  </maintenance-domain>
</config>
