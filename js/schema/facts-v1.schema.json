    "Facts": {
      "title": "DeviceFacts",
      "type": "object",
      "description": "What the device's configuration says. Every value read from a configuration is text, as written; flags derived by the extractor are booleans. The SAOS 10 fields are absent on SAOS 6 / 8 devices.",
      "properties": {
        "hostname": {
          "type": [
            "string",
            "null"
          ],
          "description": "The configured hostname."
        },
        "interfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Interface"
          },
          "description": "Layer-3 interfaces, in configuration order."
        },
        "gateway": {
          "type": [
            "string",
            "null"
          ],
          "description": "SAOS 6: the default gateway."
        },
        "vlans": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Vlan"
          },
          "description": "VLANs by id (as text)."
        },
        "ports": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Port"
          },
          "description": "Ports by name."
        },
        "lags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Lag"
          },
          "description": "LAGs."
        },
        "sub_ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SubPort"
          },
          "description": "SAOS 6 sub-ports."
        },
        "rings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Ring"
          },
          "description": "SAOS 6 logical rings."
        },
        "peers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Peer"
          },
          "description": "MPLS VCs, MPLS-TP tunnel ends and BGP neighbours."
        },
        "isis": {
          "$ref": "#/$defs/Isis"
        },
        "segment_routing": {
          "$ref": "#/$defs/SegmentRouting"
        },
        "bgp": {
          "$ref": "#/$defs/Bgp"
        },
        "pseudowires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Pseudowire"
          },
          "description": "Pseudowires."
        },
        "cfm": {
          "$ref": "#/$defs/Cfm"
        },
        "lines": {
          "type": "integer",
          "minimum": 0,
          "description": "SAOS 6: command lines seen. SAOS 10: top-level YANG objects seen (same as `objects`)."
        },
        "recognised": {
          "type": "integer",
          "minimum": 0,
          "description": "Lines (SAOS 6) or top-level objects (SAOS 10) that produced a fact."
        },
        "fds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Fd"
          },
          "description": "SAOS 10 forwarding domains."
        },
        "fps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Fp"
          },
          "description": "SAOS 10 flow points."
        },
        "classifiers": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "VLAN ids."
          },
          "description": "SAOS 10 classifiers by name: the VLAN ids they match."
        },
        "vrfs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "SAOS 10 VRF names."
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Segment"
          },
          "description": "SAOS 10 EVPN ethernet segments."
        },
        "objects": {
          "type": "integer",
          "minimum": 0,
          "description": "SAOS 10: top-level YANG objects seen across the device's files."
        }
      },
      "required": [
        "hostname",
        "interfaces",
        "gateway",
        "vlans",
        "ports",
        "lags",
        "sub_ports",
        "rings",
        "peers",
        "isis",
        "segment_routing",
        "bgp",
        "pseudowires",
        "cfm",
        "lines",
        "recognised"
      ]
    }
